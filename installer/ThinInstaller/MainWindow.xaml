<Window x:Class="Snapcode.ThinInstaller.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Snapcode Setup — v0.1.0" Height="430" Width="520"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#0F172A" Foreground="#F8FAFC"
        FontFamily="Segoe UI, Segoe UI Variable, Arial"
        Icon="app.ico">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,20">
            <Border Width="56" Height="56" CornerRadius="14" Background="#1E293B" BorderBrush="#38BDF8" BorderThickness="2" Margin="0,0,16,0">
                <Image Source="app.ico" Width="40" Height="40" VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Snapcode" FontSize="24" FontWeight="Bold" Foreground="#38BDF8"/>
                <TextBlock Text="Visual Flutter App Builder &amp; IDE — v0.1.0" FontSize="13" Foreground="#94A3B8" Margin="0,2,0,0"/>
                <TextBlock Text="Publisher: hkpc labs" FontSize="11" Foreground="#64748B" Margin="0,2,0,0"/>
            </StackPanel>
        </StackPanel>

        <!-- Path Box -->
        <StackPanel Grid.Row="1" Margin="0,0,0,16">
            <TextBlock Text="Installation Folder:" FontSize="12" FontWeight="SemiBold" Foreground="#CBD5E1" Margin="0,0,0,6"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="TxtPath" Grid.Column="0" Height="34" VerticalContentAlignment="Center"
                         Background="#1E293B" Foreground="#F8FAFC" BorderBrush="#334155" Padding="10,0" FontSize="12"/>
                <Button x:Name="BtnBrowse" Grid.Column="1" Content="Browse..." Width="80" Height="34" Margin="8,0,0,0"
                        Background="#334155" Foreground="#F8FAFC" BorderThickness="0" Cursor="Hand" Click="BtnBrowse_Click"/>
            </Grid>
        </StackPanel>

        <!-- Options -->
        <StackPanel Grid.Row="2" VerticalAlignment="Top" Margin="0,0,0,12">
            <CheckBox x:Name="ChkDesktop" Content="Create Desktop Shortcut" IsChecked="True" Foreground="#CBD5E1" Margin="0,0,0,8"/>
            <CheckBox x:Name="ChkStartMenu" Content="Create Start Menu Shortcut" IsChecked="True" Foreground="#CBD5E1" Margin="0,0,0,8"/>
            <CheckBox x:Name="ChkLaunch" Content="Launch Snapcode when finished" IsChecked="True" Foreground="#CBD5E1" Margin="0,0,0,8"/>
        </StackPanel>

        <!-- Progress / Status -->
        <StackPanel Grid.Row="3" Margin="0,0,0,16">
            <TextBlock x:Name="TxtStatus" Text="Ready to install" FontSize="12" Foreground="#94A3B8" Margin="0,0,0,6"/>
            <ProgressBar x:Name="ProgBar" Height="6" Visibility="Collapsed" Background="#1E293B" Foreground="#38BDF8" BorderThickness="0"/>
        </StackPanel>

        <!-- Buttons -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="BtnCancel" Grid.Column="1" Content="Cancel" Width="85" Height="34" Margin="0,0,10,0"
                    Background="Transparent" Foreground="#94A3B8" BorderBrush="#334155" BorderThickness="1" Click="BtnCancel_Click"/>
            <Button x:Name="BtnInstall" Grid.Column="2" Content="Install Now" Width="105" Height="34"
                    Background="#0284C7" Foreground="#FFFFFF" FontWeight="SemiBold" BorderThickness="0" Click="BtnInstall_Click"/>
        </Grid>
    </Grid>
</Window>
