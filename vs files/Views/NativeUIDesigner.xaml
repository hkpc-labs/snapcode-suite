<UserControl
    x:Class="Snapcode.Views.NativeUIDesigner"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Snapcode.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    IsTabStop="True"
    KeyDown="UserControl_KeyDown">

    <Grid KeyboardAcceleratorPlacementMode="Hidden">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Modifiers="Control" Key="S" Invoked="Save_Invoked" />
        </Grid.KeyboardAccelerators>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="250" />
        </Grid.ColumnDefinitions>

        <!-- Palette -->
        <Grid Grid.Column="0" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,1,0" Background="{ThemeResource LayerFillColorDefaultBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                <TextBlock Text="Widget Palette" FontWeight="SemiBold" Padding="12" />
            </Border>
            <ListView x:Name="PaletteList" Grid.Row="1" CanDragItems="True" DragItemsStarting="PaletteList_DragItemsStarting">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="8" Padding="4">
                            <FontIcon Glyph="{Binding Icon}" FontSize="14" />
                            <TextBlock Text="{Binding Name}" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <!-- Canvas -->
        <Grid Grid.Column="1" Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Canvas Top Toolbar (Presets, Orientation, Dual Preview & Scale) -->
            <Border Grid.Row="0" Background="{ThemeResource SystemControlBackgroundChromeMediumLowBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="12,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Left: Quick Device Category Toggles & Fine Resolution Dropdown -->
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <!-- Quick Device Category Buttons (Icon-Only UI Pattern) -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4" Padding="2">
                            <StackPanel Orientation="Horizontal" Spacing="2">
                                <Button x:Name="BtnDeviceMobile" Click="BtnDeviceMobile_Click" ToolTipService.ToolTip="Mobile Phone Preview (Ctrl+1)" Width="30" Height="28" Padding="0" CornerRadius="3" Background="{ThemeResource AccentFillColorDefaultBrush}" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}">
                                    <FontIcon Glyph="&#xE8EA;" FontSize="13" />
                                </Button>
                                <Button x:Name="BtnDeviceTablet" Click="BtnDeviceTablet_Click" ToolTipService.ToolTip="Tablet Preview (Ctrl+2)" Width="30" Height="28" Padding="0" CornerRadius="3" Background="Transparent" Foreground="{ThemeResource TextFillColorPrimaryBrush}">
                                    <FontIcon Glyph="&#xE70A;" FontSize="13" />
                                </Button>
                                <Button x:Name="BtnDeviceDesktop" Click="BtnDeviceDesktop_Click" ToolTipService.ToolTip="Desktop / Laptop Fast Preview (Ctrl+3)" Width="30" Height="28" Padding="0" CornerRadius="3" Background="Transparent" Foreground="{ThemeResource TextFillColorPrimaryBrush}">
                                    <FontIcon Glyph="&#xE7F8;" FontSize="13" />
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- Resolution Preset Dropdown -->
                        <ComboBox x:Name="ComboDeviceResolution" SelectionChanged="ComboDeviceResolution_SelectionChanged" Width="185" Height="30" Padding="8,2" FontSize="11" ToolTipService.ToolTip="Select Screen Resolution Preset" VerticalAlignment="Center" />

                        <!-- Viewport Info Text -->
                        <TextBlock x:Name="TxtCanvasInfo" Text="390 x 844 (Portrait)" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="4,0,0,0" />
                    </StackPanel>

                    <!-- Right: Undo/Redo, Rotate Orientation, Dual Preview Mode, and Zoom Scale -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <!-- Designer Undo & Redo (Icon-Only UI Pattern) -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4" Padding="2">
                            <StackPanel Orientation="Horizontal" Spacing="2">
                                <Button x:Name="BtnTopUndo" Click="BtnTopUndo_Click" ToolTipService.ToolTip="Undo Designer Action (Ctrl+Z)" Width="28" Height="28" Padding="0" CornerRadius="3" Background="Transparent" BorderThickness="0">
                                    <FontIcon Glyph="&#xE7A7;" FontSize="12" />
                                </Button>
                                <Button x:Name="BtnTopRedo" Click="BtnTopRedo_Click" ToolTipService.ToolTip="Redo Designer Action (Ctrl+Y)" Width="28" Height="28" Padding="0" CornerRadius="3" Background="Transparent" BorderThickness="0">
                                    <FontIcon Glyph="&#xE7A6;" FontSize="12" />
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- Rotate Orientation (Icon-Only UI Pattern - NO EMOJIS) -->
                        <Button x:Name="BtnRotateCanvas" Click="BtnRotateCanvas_Click" ToolTipService.ToolTip="Rotate Canvas Orientation (Ctrl+R)" Width="32" Height="32" Padding="0" CornerRadius="4">
                            <FontIcon x:Name="IconOrientation" Glyph="&#xE7AD;" FontSize="14" />
                        </Button>

                        <!-- Dual Preview Toggle Button (Icon-Only UI Pattern) -->
                        <ToggleButton x:Name="BtnDualPreview" Click="BtnDualPreview_Click" ToolTipService.ToolTip="Toggle Dual Preview (Ctrl+D)" Width="32" Height="32" Padding="0" CornerRadius="4">
                            <FontIcon Glyph="&#xE7C4;" FontSize="14" />
                        </ToggleButton>

                        <!-- Scale / Zoom Dropdown -->
                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" Margin="4,0,0,0">
                            <FontIcon Glyph="&#xE71E;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                            <ComboBox x:Name="ComboCanvasScale" SelectionChanged="ComboCanvasScale_SelectionChanged" Width="75" Height="30" Padding="6,2" FontSize="11" ToolTipService.ToolTip="Canvas Zoom Scale">
                                <ComboBoxItem Content="100%" IsSelected="True" Tag="1.0" />
                                <ComboBoxItem Content="85%" Tag="0.85" />
                                <ComboBoxItem Content="75%" Tag="0.75" />
                                <ComboBoxItem Content="60%" Tag="0.60" />
                                <ComboBoxItem Content="50%" Tag="0.50" />
                            </ComboBox>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <ScrollViewer x:Name="CanvasScrollViewer" Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" SizeChanged="CanvasScrollViewer_SizeChanged">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24">
                    <!-- Responsive Display Accommodation Notice -->
                    <Border x:Name="InfoDualPreviewNotice" Visibility="Collapsed" Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,16" HorizontalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE946;" FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="Compact display width detected: Previews are arranged vertically to fit your screen." FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                            <Button x:Name="BtnCloseNotice" Click="BtnCloseNotice_Click" Padding="4" Background="Transparent" BorderThickness="0" Margin="8,0,0,0" ToolTipService.ToolTip="Dismiss">
                                <FontIcon Glyph="&#xE711;" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Canvas Container with Primary and Secondary Frames -->
                    <StackPanel x:Name="CanvasContainer" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="28">
                        <StackPanel.RenderTransform>
                            <ScaleTransform x:Name="CanvasScaleTransform" ScaleX="1.0" ScaleY="1.0" />
                        </StackPanel.RenderTransform>

                        <!-- Primary Frame Container (Interactive & Editable) -->
                        <StackPanel x:Name="PrimaryFrameWrapper" Spacing="8" VerticalAlignment="Top">
                            <!-- Primary Frame Badge / Header -->
                            <Grid HorizontalAlignment="Stretch" Margin="4,0">
                                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <Border Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="10" Padding="8,2">
                                        <TextBlock Text="Primary (Interactive)" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                    </Border>
                                    <TextBlock x:Name="TxtPrimaryOrientationBadge" Text="Portrait" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Grid>

                            <!-- Primary Phone Frame Mockup -->
                            <Border x:Name="PhoneFrameBorder" Width="390" Height="844" Background="White" CornerRadius="16" BorderBrush="{ThemeResource TextFillColorPrimaryBrush}" BorderThickness="4" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border.RenderTransform>
                                    <TranslateTransform x:Name="PrimaryTransform" X="0" Y="0" />
                                </Border.RenderTransform>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="24" /> <!-- Status Bar -->
                                        <RowDefinition Height="56" /> <!-- Tool Bar -->
                                        <RowDefinition Height="*" /> <!-- App Content -->
                                    </Grid.RowDefinitions>
                                    
                                    <!-- Fake Status Bar -->
                                    <Grid x:Name="MockStatusBar" Grid.Row="0" Background="#0288D1">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,0,8,0">
                                            <FontIcon Glyph="&#xE701;" FontSize="12" Foreground="White" /> <!-- Wifi -->
                                            <FontIcon Glyph="&#xE83F;" FontSize="12" Foreground="White" /> <!-- Battery -->
                                            <TextBlock Text="12:00" FontSize="12" Foreground="White" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Grid>
                                    
                                    <!-- Fake Tool Bar -->
                                    <Grid x:Name="MockToolBar" Grid.Row="1" Background="#03A9F4">
                                        <Button x:Name="BtnDrawerLeading" Content="&#xE700;" FontFamily="Segoe MDL2 Assets" Background="Transparent" Foreground="White" BorderThickness="0" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="8,0,0,0" Width="40" Height="40" Padding="0" Visibility="Collapsed" IsHitTestVisible="False" />
                                        <TextBlock x:Name="TxtAppTitle" Text="main.dart" FontSize="18" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center" Margin="16,0,0,0" />
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0">
                                            <Button x:Name="BtnUndo" Content="&#xE7A7;" FontFamily="Segoe MDL2 Assets" Background="Transparent" Foreground="White" BorderThickness="0" Click="BtnUndo_Click" />
                                            <Button x:Name="BtnRedo" Content="&#xE7A6;" FontFamily="Segoe MDL2 Assets" Background="Transparent" Foreground="White" BorderThickness="0" Click="BtnRedo_Click" />
                                        </StackPanel>
                                    </Grid>
                                    
                                    <!-- Tool Bar Elevation Shadow -->
                                    <Border x:Name="MockAppBarShadow" Grid.Row="2" VerticalAlignment="Top" Height="8" Visibility="Collapsed" IsHitTestVisible="False">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                                <GradientStop Color="#4D000000" Offset="0" />
                                                <GradientStop Color="#00000000" Offset="1" />
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                    
                                    <!-- Real Drag/Drop Canvas -->
                                    <Grid Grid.Row="2" x:Name="RootCanvas" AllowDrop="True" DragOver="RootCanvas_DragOver" Drop="RootCanvas_Drop" Background="Transparent" />

                                    <!-- Mock Floating Action Button -->
                                    <Button x:Name="MockFAB" Grid.Row="2" Width="56" Height="56" CornerRadius="28" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="16" Background="#2196F3" Foreground="White" Visibility="Collapsed" IsHitTestVisible="False" Padding="0">
                                        <FontIcon x:Name="MockFABIcon" Glyph="&#xE710;" FontSize="20" Foreground="White" />
                                    </Button>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- Secondary Frame Container (Live Mirror Preview) -->
                        <StackPanel x:Name="SecondaryFrameWrapper" Spacing="8" VerticalAlignment="Top" Visibility="Collapsed" Opacity="0">
                            <!-- Secondary Frame Header / "Set as Primary" Action -->
                            <Grid HorizontalAlignment="Stretch" Margin="4,0">
                                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <Border Background="{ThemeResource SystemControlBackgroundChromeMediumBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10" Padding="8,2">
                                        <TextBlock Text="Secondary (Live Mirror)" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </Border>
                                    <TextBlock x:Name="TxtSecondaryOrientationBadge" Text="Landscape" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                </StackPanel>

                                <Button x:Name="BtnSetSecondaryAsPrimary" Click="BtnSetSecondaryAsPrimary_Click" HorizontalAlignment="Right" Padding="8,2" CornerRadius="4" ToolTipService.ToolTip="Make this view the primary editable canvas">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <FontIcon Glyph="&#xE748;" FontSize="11" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                        <TextBlock Text="Set as Primary" FontSize="11" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <!-- Secondary Frame Border -->
                            <Border x:Name="SecondaryFrameBorder" Width="844" Height="390" Background="White" CornerRadius="16" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="3" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border.RenderTransform>
                                    <TranslateTransform x:Name="SecondaryTransform" X="0" Y="0" />
                                </Border.RenderTransform>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="24" />
                                        <RowDefinition Height="56" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <!-- Fake Status Bar -->
                                    <Grid x:Name="SecondaryMockStatusBar" Grid.Row="0" Background="#0288D1">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,0,8,0">
                                            <FontIcon Glyph="&#xE701;" FontSize="12" Foreground="White" />
                                            <FontIcon Glyph="&#xE83F;" FontSize="12" Foreground="White" />
                                            <TextBlock Text="12:00" FontSize="12" Foreground="White" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Grid>

                                    <!-- Fake Tool Bar -->
                                    <Grid x:Name="SecondaryMockToolBar" Grid.Row="1" Background="#03A9F4">
                                        <TextBlock x:Name="SecondaryTxtAppTitle" Text="main.dart" FontSize="18" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center" Margin="16,0,0,0" />
                                    </Grid>

                                    <!-- Tool Bar Elevation Shadow -->
                                    <Border x:Name="SecondaryMockAppBarShadow" Grid.Row="2" VerticalAlignment="Top" Height="8" Visibility="Collapsed" IsHitTestVisible="False">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                                <GradientStop Color="#4D000000" Offset="0" />
                                                <GradientStop Color="#00000000" Offset="1" />
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>

                                    <!-- Live Mirror Canvas (Read-Only Mirror) -->
                                    <Grid Grid.Row="2" x:Name="SecondaryRootCanvas" Background="Transparent" />

                                    <!-- Mock Floating Action Button -->
                                    <Button x:Name="SecondaryMockFAB" Grid.Row="2" Width="56" Height="56" CornerRadius="28" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="16" Background="#2196F3" Foreground="White" Visibility="Collapsed" IsHitTestVisible="False" Padding="0">
                                        <FontIcon x:Name="SecondaryMockFABIcon" Glyph="&#xE710;" FontSize="20" Foreground="White" />
                                    </Button>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Properties -->
        <Grid Grid.Column="2" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1,0,0,0" Background="{ThemeResource LayerFillColorDefaultBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                <StackPanel Orientation="Horizontal" Padding="12" Spacing="24">
                    <RadioButton x:Name="RadioProperties" Content="Properties" IsChecked="True" Checked="Tab_Checked" />
                    <RadioButton x:Name="RadioEvents" Content="Events" Checked="Tab_Checked" />
                </StackPanel>
            </Border>
            
            <ComboBox x:Name="WidgetNavigator" Grid.Row="1" HorizontalAlignment="Stretch" Margin="12,12,12,0" 
                      Header="Widget Navigator" DisplayMemberPath="Id" SelectionChanged="WidgetNavigator_SelectionChanged" />
            
            <ScrollViewer Grid.Row="2">
                <Grid>
                    <StackPanel x:Name="PropertiesPanel" Padding="16" Spacing="12" Visibility="Collapsed">
                        <TextBlock x:Name="TxtPropType" Text="Type: Button" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        
                        <TextBox x:Name="InputPropId" Header="Widget ID" PlaceholderText="e.g. myButton" TextChanged="InputPropId_TextChanged" />
                        <TextBox x:Name="InputPropName" Header="Text / Value" PlaceholderText="e.g. Submit" TextChanged="InputPropName_TextChanged" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="InputPropAssetPath" Grid.Column="0" Header="Asset Path" PlaceholderText="e.g. img.png" TextChanged="InputPropAssetPath_TextChanged" Margin="0,0,4,0" />
                        <Button x:Name="BtnBrowseAsset" Grid.Column="1" Content="..." VerticalAlignment="Bottom" Click="BtnBrowseAsset_Click" />
                    </Grid>
                    
                    <!-- Layout Properties -->
                    <TextBlock Text="Layout" FontWeight="SemiBold" Margin="0,12,0,0" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="ComboPropWidth" Grid.Column="0" Header="Width" HorizontalAlignment="Stretch" IsEditable="True" SelectionChanged="ComboPropWidth_SelectionChanged" TextSubmitted="ComboPropWidth_TextSubmitted" LostFocus="ComboPropWidth_LostFocus">
                            <x:String>Auto</x:String>
                            <x:String>Match Parent</x:String>
                            <x:String>40dp</x:String>
                            <x:String>50dp</x:String>
                            <x:String>80dp</x:String>
                            <x:String>100dp</x:String>
                            <x:String>120dp</x:String>
                            <x:String>150dp</x:String>
                            <x:String>200dp</x:String>
                            <x:String>250dp</x:String>
                            <x:String>300dp</x:String>
                            <x:String>25%</x:String>
                            <x:String>50%</x:String>
                            <x:String>75%</x:String>
                            <x:String>100%</x:String>
                        </ComboBox>
                        <ComboBox x:Name="ComboPropHeight" Grid.Column="1" Header="Height" HorizontalAlignment="Stretch" IsEditable="True" SelectionChanged="ComboPropHeight_SelectionChanged" TextSubmitted="ComboPropHeight_TextSubmitted" LostFocus="ComboPropHeight_LostFocus">
                            <x:String>Auto</x:String>
                            <x:String>Match Parent</x:String>
                            <x:String>40dp</x:String>
                            <x:String>50dp</x:String>
                            <x:String>80dp</x:String>
                            <x:String>100dp</x:String>
                            <x:String>120dp</x:String>
                            <x:String>150dp</x:String>
                            <x:String>200dp</x:String>
                            <x:String>250dp</x:String>
                            <x:String>300dp</x:String>
                            <x:String>25%</x:String>
                            <x:String>50%</x:String>
                            <x:String>75%</x:String>
                            <x:String>100%</x:String>
                        </ComboBox>
                    </Grid>
                    
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="InputPropPadding" Grid.Column="0" Header="Padding" PlaceholderText="e.g. 8" TextChanged="InputPropPadding_TextChanged" />
                        <TextBox x:Name="InputPropMargin" Grid.Column="1" Header="Margin" PlaceholderText="e.g. 8" TextChanged="InputPropMargin_TextChanged" />
                    </Grid>
                    
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="ComboPropAlignment" Grid.Column="0" Header="Alignment" HorizontalAlignment="Stretch" IsEditable="True" SelectionChanged="ComboPropAlignment_SelectionChanged" TextSubmitted="ComboPropAlignment_TextSubmitted" LostFocus="ComboPropAlignment_LostFocus">
                            <x:String>Default</x:String>
                            <x:String>TopLeft</x:String>
                            <x:String>TopCenter</x:String>
                            <x:String>TopRight</x:String>
                            <x:String>CenterLeft</x:String>
                            <x:String>Center</x:String>
                            <x:String>CenterRight</x:String>
                            <x:String>BottomLeft</x:String>
                            <x:String>BottomCenter</x:String>
                            <x:String>BottomRight</x:String>
                        </ComboBox>
                        <ComboBox x:Name="ComboPropGravity" Grid.Column="1" Header="Gravity" HorizontalAlignment="Stretch" IsEditable="True" SelectionChanged="ComboPropGravity_SelectionChanged" TextSubmitted="ComboPropGravity_TextSubmitted" LostFocus="ComboPropGravity_LostFocus">
                            <x:String>Default</x:String>
                            <x:String>TopLeft</x:String>
                            <x:String>TopCenter</x:String>
                            <x:String>TopRight</x:String>
                            <x:String>CenterLeft</x:String>
                            <x:String>Center</x:String>
                            <x:String>CenterRight</x:String>
                            <x:String>BottomLeft</x:String>
                            <x:String>BottomCenter</x:String>
                            <x:String>BottomRight</x:String>
                            <x:String>Stretch</x:String>
                            <x:String>CenterHorizontal</x:String>
                            <x:String>CenterVertical</x:String>
                        </ComboBox>
                    </Grid>

                    <!-- Styling Properties -->
                    <TextBlock Text="Styling" FontWeight="SemiBold" Margin="0,12,0,0" />
                    
                    <DropDownButton HorizontalAlignment="Stretch" Margin="0,8,0,0">
                        <DropDownButton.Content>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Border x:Name="PreviewPropBgColor" Width="16" Height="16" BorderBrush="{ThemeResource TextFillColorPrimaryBrush}" BorderThickness="1" CornerRadius="8" Background="Transparent" />
                                <TextBlock Text="Background Color" />
                            </StackPanel>
                        </DropDownButton.Content>
                        <DropDownButton.Flyout>
                            <Flyout>
                                <ColorPicker x:Name="PickerPropBgColor" ColorChanged="PickerPropBgColor_ColorChanged" IsColorChannelTextInputVisible="True" IsHexInputVisible="True" IsAlphaEnabled="True" />
                            </Flyout>
                        </DropDownButton.Flyout>
                    </DropDownButton>
                    
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <DropDownButton Grid.Column="0" HorizontalAlignment="Stretch" Margin="0,24,0,0">
                            <DropDownButton.Content>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Border x:Name="PreviewPropTextColor" Width="16" Height="16" BorderBrush="{ThemeResource TextFillColorPrimaryBrush}" BorderThickness="1" CornerRadius="8" Background="Transparent" />
                                    <TextBlock Text="Text Color" />
                                </StackPanel>
                            </DropDownButton.Content>
                            <DropDownButton.Flyout>
                                <Flyout>
                                    <ColorPicker x:Name="PickerPropTextColor" ColorChanged="PickerPropTextColor_ColorChanged" IsColorChannelTextInputVisible="True" IsHexInputVisible="True" IsAlphaEnabled="True" />
                                </Flyout>
                            </DropDownButton.Flyout>
                        </DropDownButton>
                        <TextBox x:Name="InputPropTextSize" Grid.Column="1" Header="Text Size" PlaceholderText="e.g. 14" TextChanged="InputPropTextSize_TextChanged" />
                    </Grid>
                    
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="InputPropBorderWidth" Grid.Column="0" Header="Border Width" PlaceholderText="e.g. 0" TextChanged="InputPropBorderWidth_TextChanged" />
                        <TextBox x:Name="InputPropCornerRadius" Grid.Column="1" Header="Corner Radius" PlaceholderText="e.g. 0" TextChanged="InputPropCornerRadius_TextChanged" />
                    </Grid>
                    <DropDownButton HorizontalAlignment="Stretch" Margin="0,8,0,0">
                        <DropDownButton.Content>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Border x:Name="PreviewPropBorderColor" Width="16" Height="16" BorderBrush="{ThemeResource TextFillColorPrimaryBrush}" BorderThickness="1" CornerRadius="8" Background="Transparent" />
                                <TextBlock Text="Border Color" />
                            </StackPanel>
                        </DropDownButton.Content>
                        <DropDownButton.Flyout>
                            <Flyout>
                                <ColorPicker x:Name="PickerPropBorderColor" ColorChanged="PickerPropBorderColor_ColorChanged" IsColorChannelTextInputVisible="True" IsHexInputVisible="True" IsAlphaEnabled="True" />
                            </Flyout>
                        </DropDownButton.Flyout>
                    </DropDownButton>
                    <ToggleSwitch x:Name="ToggleShadow" Header="Drop Shadow" OnContent="Yes" OffContent="No" Toggled="ToggleShadow_Toggled" Margin="0,8,0,0" />
                    
                    <!-- Widget Specific Properties -->
                    <StackPanel x:Name="PanelTextSpecific" Visibility="Collapsed" Spacing="8" Margin="0,12,0,0">
                        <TextBlock Text="Text Properties" FontWeight="SemiBold" />
                        <ComboBox x:Name="ComboFontWeight" Header="Font Weight" HorizontalAlignment="Stretch" SelectionChanged="ComboFontWeight_SelectionChanged">
                            <x:String>Normal</x:String>
                            <x:String>Bold</x:String>
                        </ComboBox>
                        <ComboBox x:Name="ComboTextAlign" Header="Text Align" HorizontalAlignment="Stretch" SelectionChanged="ComboTextAlign_SelectionChanged">
                            <x:String>Left</x:String>
                            <x:String>Center</x:String>
                            <x:String>Right</x:String>
                        </ComboBox>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="InputPropFontFamily" Grid.Column="0" Header="Font Asset" PlaceholderText="Select Font..." IsReadOnly="True" />
                            <Button x:Name="BtnBrowseFontAsset" Grid.Column="1" Content="..." VerticalAlignment="Bottom" Margin="4,0,0,0" Click="BtnBrowseFontAsset_Click" />
                        </Grid>
                    </StackPanel>

                    <StackPanel x:Name="PanelFlexSpecific" Visibility="Collapsed" Spacing="8" Margin="0,12,0,0">
                        <TextBlock Text="Flex Properties" FontWeight="SemiBold" />
                        <ComboBox x:Name="ComboMainAxis" Header="Main Axis Alignment" HorizontalAlignment="Stretch" SelectionChanged="ComboMainAxis_SelectionChanged">
                            <x:String>Start</x:String>
                            <x:String>Center</x:String>
                            <x:String>End</x:String>
                            <x:String>SpaceBetween</x:String>
                            <x:String>SpaceAround</x:String>
                            <x:String>SpaceEvenly</x:String>
                        </ComboBox>
                        <ComboBox x:Name="ComboCrossAxis" Header="Cross Axis Alignment" HorizontalAlignment="Stretch" SelectionChanged="ComboCrossAxis_SelectionChanged">
                            <x:String>Start</x:String>
                            <x:String>Center</x:String>
                            <x:String>End</x:String>
                            <x:String>Stretch</x:String>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel x:Name="PanelListSpecific" Visibility="Collapsed" Spacing="8" Margin="0,12,0,0">
                        <TextBlock Text="Scroll Properties" FontWeight="SemiBold" />
                        <ComboBox x:Name="ComboScrollDirection" Header="Direction" HorizontalAlignment="Stretch" SelectionChanged="ComboScrollDirection_SelectionChanged">
                            <x:String>Vertical</x:String>
                            <x:String>Horizontal</x:String>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel x:Name="PanelImageSpecific" Visibility="Collapsed" Spacing="8" Margin="0,12,0,0">
                        <TextBlock Text="Image Properties" FontWeight="SemiBold" />
                        <ComboBox x:Name="ComboAssetUsage" Header="Asset Usage" HorizontalAlignment="Stretch" SelectionChanged="ComboAssetUsage_SelectionChanged">
                            <x:String>Image</x:String>
                            <x:String>Background</x:String>
                        </ComboBox>
                        <ComboBox x:Name="ComboBoxFit" Header="Box Fit" HorizontalAlignment="Stretch" SelectionChanged="ComboBoxFit_SelectionChanged">
                            <x:String>Contain</x:String>
                            <x:String>Cover</x:String>
                            <x:String>Fill</x:String>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel x:Name="PanelInputSpecific" Visibility="Collapsed" Spacing="8" Margin="0,12,0,0">
                        <TextBlock Text="Input Properties" FontWeight="SemiBold" />
                        <ToggleSwitch x:Name="ToggleObscureText" Header="Obscure Text (Password)" Toggled="ToggleObscureText_Toggled" />
                        <TextBox x:Name="InputPropHintText" Header="Hint Text" PlaceholderText="e.g. Enter name..." TextChanged="InputPropHintText_TextChanged" />
                        <ComboBox x:Name="ComboInputType" Header="Input Type" HorizontalAlignment="Stretch" SelectionChanged="ComboInputType_SelectionChanged">
                            <x:String>Text</x:String>
                            <x:String>Number</x:String>
                            <x:String>Email</x:String>
                            <x:String>Phone</x:String>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel x:Name="PanelToggleSpecific" Visibility="Collapsed" Spacing="8" Margin="0,12,0,0">
                        <TextBlock Text="Toggle Properties" FontWeight="SemiBold" />
                        <ToggleSwitch x:Name="ToggleIsChecked" Header="Default Checked" Toggled="ToggleIsChecked_Toggled" />
                        <DropDownButton HorizontalAlignment="Stretch" Margin="0,8,0,0">
                            <DropDownButton.Content>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Border x:Name="PreviewPropActiveColor" Width="16" Height="16" BorderBrush="{ThemeResource TextFillColorPrimaryBrush}" BorderThickness="1" CornerRadius="8" Background="Transparent" />
                                    <TextBlock Text="Active Color" />
                                </StackPanel>
                            </DropDownButton.Content>
                            <DropDownButton.Flyout>
                                <Flyout>
                                    <ColorPicker x:Name="PickerPropActiveColor" ColorChanged="PickerPropActiveColor_ColorChanged" IsColorChannelTextInputVisible="True" IsHexInputVisible="True" IsAlphaEnabled="True" />
                                </Flyout>
                            </DropDownButton.Flyout>
                        </DropDownButton>
                    </StackPanel>

                    <StackPanel x:Name="PanelSliderSpecific" Visibility="Collapsed" Spacing="8" Margin="0,12,0,0">
                        <TextBlock Text="Slider Properties" FontWeight="SemiBold" />
                        <TextBox x:Name="InputPropMinValue" Header="Min Value" PlaceholderText="0" TextChanged="InputPropMinValue_TextChanged" />
                        <TextBox x:Name="InputPropMaxValue" Header="Max Value" PlaceholderText="100" TextChanged="InputPropMaxValue_TextChanged" />
                        <TextBox x:Name="InputPropCurrentValue" Header="Current Value" PlaceholderText="50" TextChanged="InputPropCurrentValue_TextChanged" />
                        <DropDownButton HorizontalAlignment="Stretch" Margin="0,8,0,0">
                            <DropDownButton.Content>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Border x:Name="PreviewPropSliderActiveColor" Width="16" Height="16" BorderBrush="{ThemeResource TextFillColorPrimaryBrush}" BorderThickness="1" CornerRadius="8" Background="Transparent" />
                                    <TextBlock Text="Active Color" />
                                </StackPanel>
                            </DropDownButton.Content>
                            <DropDownButton.Flyout>
                                <Flyout>
                                    <ColorPicker x:Name="PickerPropSliderActiveColor" ColorChanged="PickerPropSliderActiveColor_ColorChanged" IsColorChannelTextInputVisible="True" IsHexInputVisible="True" IsAlphaEnabled="True" />
                                </Flyout>
                            </DropDownButton.Flyout>
                        </DropDownButton>
                    </StackPanel>

                    <StackPanel x:Name="PanelExpandedSpecific" Visibility="Collapsed" Spacing="8" Margin="0,12,0,0">
                        <TextBlock Text="Flex/Expanded Properties" FontWeight="SemiBold" />
                        <TextBox x:Name="InputPropFlex" Header="Flex Ratio" PlaceholderText="1" TextChanged="InputPropFlex_TextChanged" />
                    </StackPanel>
                    
                    <Button x:Name="BtnDeleteWidget" Content="Delete Widget" Foreground="{ThemeResource SystemFillColorCriticalBrush}" Click="BtnDeleteWidget_Click" HorizontalAlignment="Stretch" Margin="0,24,0,0" />
                </StackPanel>
                
                <StackPanel x:Name="EventsPanel" Padding="16" Spacing="12" Visibility="Collapsed">
                    <TextBlock x:Name="TxtEventsTargetWidget" Text="Available Events" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="Select an event to open its Blockly logic workspace." FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" />
                    
                    <ListView x:Name="ListEvents" SelectionMode="Single" SelectionChanged="ListEvents_SelectionChanged">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="10,8" Margin="0,2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Glyph="{Binding Icon}" FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Spacing="2">
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="13" />
                                            <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                        <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
              </Grid>
            </ScrollViewer>
            
            <TextBlock x:Name="TxtNoSelection" Grid.Row="2" Text="Select a widget in the canvas to edit its properties." TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="24" TextAlignment="Center" />
        </Grid>
    </Grid>
</UserControl>
