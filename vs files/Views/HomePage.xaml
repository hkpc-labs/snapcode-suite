<Page
    x:Class="Snapcode.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Snapcode.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent">

    <Grid Background="Transparent">
        <NavigationView x:Name="NavView" 
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="True"
                        PaneDisplayMode="Auto"
                        SelectionChanged="NavView_SelectionChanged"
                        ItemInvoked="NavView_ItemInvoked"
                        Loaded="NavView_Loaded">
            <NavigationView.Resources>
                <LinearGradientBrush x:Key="NavigationViewDefaultPaneBackground" StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#0087CEFA" Offset="0.0" />
                    <GradientStop Color="#3087CEFA" Offset="1.0" />
                </LinearGradientBrush>
                <LinearGradientBrush x:Key="NavigationViewExpandedPaneBackground" StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#0087CEFA" Offset="0.0" />
                    <GradientStop Color="#3087CEFA" Offset="1.0" />
                </LinearGradientBrush>
            </NavigationView.Resources>
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="NavItemProjects" Content="Projects" Tag="Projects">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8A5;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavItemTemplates" Content="Templates" Tag="Templates">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE81C;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavItemLearn" Content="Learn &amp; Docs" Tag="Learn">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE82D;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.FooterMenuItems>
                <NavigationViewItem x:Name="NavItemHelp" Content="Help &amp; Support" Tag="Help">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE897;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <!-- Main Content Area -->
            <Grid>
                <!-- Projects View -->
                <Grid x:Name="ProjectsContent" Visibility="Visible" Padding="32">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Recent Projects" 
                                   Style="{StaticResource TitleTextBlockStyle}" 
                                   VerticalAlignment="Center"/>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12">
                            <Button x:Name="BtnOpenExistingProject" 
                                    Click="BtnOpenExistingProject_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE8E5;" />
                                    <TextBlock Text="Open Project" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="BtnCreateProject" 
                                    Style="{StaticResource AccentButtonStyle}"
                                    Click="BtnCreateProject_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE710;" />
                                    <TextBlock Text="New Project" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <ListView x:Name="RecentProjectsList" 
                              Grid.Row="1"
                              IsItemClickEnabled="True"
                              ItemClick="RecentProjectsList_ItemClick"
                              SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="12" Margin="0,4" Background="{ThemeResource SystemControlBackgroundChromeMediumLowBrush}" CornerRadius="4">
                                    <Grid.ContextFlyout>
                                        <MenuFlyout>
                                            <MenuFlyoutItem Text="Reveal in Explorer" Click="MenuReveal_Click" Tag="{Binding Path}">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xED25;" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem Text="Remove from Recent" Click="MenuRemove_Click" Tag="{Binding Path}">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xECC9;" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutSeparator />
                                            <MenuFlyoutItem Text="Delete Project" Click="MenuDelete_Click" Tag="{Binding Path}" Foreground="Red">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE74D;" Foreground="Red" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                        </MenuFlyout>
                                    </Grid.ContextFlyout>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="16" />
                                        <TextBlock Text="{Binding Path}" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" FontSize="12" />
                                    </StackPanel>
                                    
                                    <Button Grid.Column="1" 
                                            Content="Open" 
                                            VerticalAlignment="Center"
                                            CommandParameter="{Binding Path}"
                                            Click="BtnOpenProject_Click" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    
                    <StackPanel x:Name="EmptyStatePanel" 
                                Grid.Row="1" 
                                HorizontalAlignment="Center" 
                                VerticalAlignment="Center" 
                                Spacing="16"
                                Visibility="Collapsed">
                        <FontIcon Glyph="&#xE8A5;" FontSize="64" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" />
                        <TextBlock Text="No recent projects" FontSize="18" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" />
                        <TextBlock Text="Create a new project to get started." Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" />
                    </StackPanel>
                </Grid>
                
                    <Grid x:Name="TemplatesContent" Visibility="Collapsed" Padding="32">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <StackPanel Grid.Row="0" Margin="0,0,0,24">
                            <TextBlock Text="Templates Gallery" Style="{StaticResource TitleTextBlockStyle}" />
                            <TextBlock Text="Pre-built Flutter templates with visual UI layouts and complete Blockly event logic ready to customize."
                                       Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                                       FontSize="14" Margin="0,4,0,0" />
                        </StackPanel>

                        <!-- Templates Grid -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <VariableSizedWrapGrid Orientation="Horizontal" ItemWidth="360" ItemHeight="360" HorizontalAlignment="Left">
                                
                                <!-- Tic-Tac-Toe Game Card -->
                                <Border Width="340" Height="340" Margin="0,0,20,20"
                                        Background="{ThemeResource SystemControlBackgroundChromeMediumLowBrush}"
                                        BorderBrush="{ThemeResource SystemControlForegroundBaseLowBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="20">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <!-- Header / Icon -->
                                        <StackPanel Orientation="Horizontal" Spacing="12">
                                            <Border Background="{ThemeResource SystemControlForegroundAccentBrush}" Width="44" Height="44" CornerRadius="8">
                                                <FontIcon Glyph="&#xE7FC;" FontSize="22" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="Tic-Tac-Toe Game" FontWeight="SemiBold" FontSize="18" />
                                                <TextBlock Text="2-Player Board Game" FontSize="12" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" />
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Badge Pills -->
                                        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="6" Margin="0,14,0,10">
                                            <Border Background="{ThemeResource SystemControlBackgroundChromeMediumBrush}" CornerRadius="4" Padding="6,2">
                                                <TextBlock Text="View Designer" FontSize="11" Foreground="{ThemeResource SystemControlForegroundAccentBrush}" FontWeight="SemiBold" />
                                            </Border>
                                            <Border Background="{ThemeResource SystemControlBackgroundChromeMediumBrush}" CornerRadius="4" Padding="6,2">
                                                <TextBlock Text="Blockly Logic" FontSize="11" Foreground="#10B981" FontWeight="SemiBold" />
                                            </Border>
                                            <Border Background="{ThemeResource SystemControlBackgroundChromeMediumBrush}" CornerRadius="4" Padding="6,2">
                                                <TextBlock Text="State Variables" FontSize="11" Foreground="#F59E0B" FontWeight="SemiBold" />
                                            </Border>
                                        </StackPanel>

                                        <!-- Description -->
                                        <TextBlock Grid.Row="2" 
                                                   Text="Classic 3x3 turn-based Tic-Tac-Toe game. Includes visual board cells, live scoreboard with win/tie tracking, game status indicators, win alerts, and restart logic built entirely using View Designer widgets and Blockly blocks."
                                                   TextWrapping="Wrap" 
                                                   FontSize="13" 
                                                   Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                                                   LineHeight="20" />

                                        <!-- Feature bullets -->
                                        <StackPanel Grid.Row="3" Margin="0,8,0,14" Spacing="4">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE73E;" FontSize="12" Foreground="{ThemeResource SystemControlForegroundAccentBrush}" VerticalAlignment="Center" />
                                                <TextBlock Text="9 interactive buttons with dynamic text" FontSize="12" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE73E;" FontSize="12" Foreground="{ThemeResource SystemControlForegroundAccentBrush}" VerticalAlignment="Center" />
                                                <TextBlock Text="Turn switching, win check, and haptic feedback" FontSize="12" />
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Action Button -->
                                        <Button Grid.Row="4" x:Name="BtnCreateTicTacToeTemplate"
                                                Style="{StaticResource AccentButtonStyle}"
                                                HorizontalAlignment="Stretch"
                                                Click="BtnCreateTicTacToeTemplate_Click">
                                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                                <FontIcon Glyph="&#xE8A7;" FontSize="14" />
                                                <TextBlock Text="Create Project from Template" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </Border>
                            </VariableSizedWrapGrid>
                        </ScrollViewer>
                    </Grid>
                    
                    <Grid x:Name="LearnContent" Visibility="Collapsed" Padding="32">
                        <TextBlock Text="Learn &amp; Documentation" Style="{StaticResource TitleTextBlockStyle}" VerticalAlignment="Top" />
                        
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="Explore official documentation and tutorials to master development." Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" Margin="0,0,0,24" HorizontalAlignment="Center" />
                            
                            <VariableSizedWrapGrid Orientation="Horizontal" ItemWidth="200" ItemHeight="150" HorizontalAlignment="Center">
                                <Button Width="180" Height="130" Margin="0,10,20,10" Click="BtnLearnFlutter_Click">
                                    <StackPanel Spacing="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE8D3;" FontSize="48" Foreground="{ThemeResource SystemControlForegroundAccentBrush}" />
                                        <TextBlock Text="Flutter" FontWeight="SemiBold" FontSize="16" />
                                    </StackPanel>
                                </Button>
                                <Button Width="180" Height="130" Margin="0,10,20,10" Click="BtnLearnDart_Click">
                                    <StackPanel Spacing="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE82D;" FontSize="48" Foreground="{ThemeResource SystemControlForegroundAccentBrush}" />
                                        <TextBlock Text="Dart" FontWeight="SemiBold" FontSize="16" />
                                    </StackPanel>
                                </Button>
                                <Button Width="180" Height="130" Margin="0,10,20,10" Click="BtnLearnMore_Click">
                                    <StackPanel Spacing="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE946;" FontSize="48" Foreground="{ThemeResource SystemControlForegroundAccentBrush}" />
                                        <TextBlock Text="Resources" FontWeight="SemiBold" FontSize="16" />
                                    </StackPanel>
                                </Button>
                            </VariableSizedWrapGrid>
                        </StackPanel>
                    </Grid>

                    <Grid x:Name="HelpContent" Visibility="Collapsed" Padding="32">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="250" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        
                        <Border BorderBrush="{ThemeResource SystemControlForegroundBaseLowBrush}" BorderThickness="0,0,1,0" Margin="0,0,24,0">
                            <ListView x:Name="HelpTopicsList" SelectionChanged="HelpTopicsList_SelectionChanged">
                                <x:String>What is Flutter?</x:String>
                                <x:String>Step-by-step: Creating a Project</x:String>
                                <x:String>Common Errors &amp; Fixes</x:String>
                            </ListView>
                        </Border>
                        
                        <ScrollViewer Grid.Column="1">
                            <StackPanel>
                                <TextBlock x:Name="HelpDetailTitle" Style="{StaticResource TitleTextBlockStyle}" Margin="0,0,0,16" />
                                <TextBlock x:Name="HelpDetailText" TextWrapping="Wrap" IsTextSelectionEnabled="True" LineHeight="28" FontSize="16" FontWeight="Thin" Margin="0,0,0,24" />
                                <StackPanel x:Name="HelpLinksPanel" Spacing="8" />
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>
        </NavigationView>

        <!-- Loading Overlay -->
        <Grid x:Name="LoadingOverlay" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" Opacity="0.95" Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16" Width="600">
                <TextBlock Text="Creating Project..." Style="{StaticResource TitleTextBlockStyle}" HorizontalAlignment="Center" />
                <ProgressBar IsIndeterminate="True" />
                <ScrollViewer MaxHeight="300" Background="Black" CornerRadius="4" Padding="8">
                    <TextBlock x:Name="LogTextBlock" FontFamily="Consolas" FontSize="12" Foreground="LightGray" TextWrapping="Wrap" />
                </ScrollViewer>
                <Button x:Name="BtnCancelCreation" Content="Cancel" HorizontalAlignment="Center" Click="BtnCancelCreation_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
