<UserControl
    x:Class="Snapcode.Views.ProjectExplorerControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Snapcode.ViewModels"
    mc:Ignorable="d"
    Background="{ThemeResource LayerFillColorDefaultBrush}">

    <UserControl.Resources>
        <MenuFlyout x:Key="ItemContextFlyout">
            <MenuFlyoutItem Text="New File..." Icon="Add" Click="MenuNewFile_Click" />
            <MenuFlyoutItem Text="New Folder..." Icon="Folder" Click="MenuNewFolder_Click" />
            <MenuFlyoutSeparator />
            <MenuFlyoutItem Text="Rename" Icon="Rename" Click="MenuRename_Click" />
            <MenuFlyoutItem Text="Delete" Icon="Delete" Click="MenuDelete_Click" />
            <MenuFlyoutSeparator />
            <MenuFlyoutItem Text="Reveal in Explorer" Icon="OpenFile" Click="MenuReveal_Click" />
            <MenuFlyoutItem Text="Copy Path" Icon="Copy" Click="MenuCopyPath_Click" />
            <MenuFlyoutItem Text="Copy Relative Path" Click="MenuCopyRelativePath_Click" />
        </MenuFlyout>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36" /> <!-- Header & Toolbar -->
            <RowDefinition Height="*" />  <!-- TreeView -->
        </Grid.RowDefinitions>

        <!-- Header & Action Bar -->
        <Grid Grid.Row="0" Background="{ThemeResource SubtleFillColorSecondaryBrush}" Padding="8,0,4,0" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <FontIcon Glyph="&#xEC50;" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock Text="EXPLORER" FontSize="11" FontWeight="Bold" CharacterSpacing="80" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                <!-- New File Button with Flyout -->
                <Button x:Name="BtnNewFile" Background="Transparent" BorderThickness="0" Padding="6,4" CornerRadius="4" ToolTipService.ToolTip="New File">
                    <FontIcon Glyph="&#xE710;" FontSize="12" />
                    <Button.Flyout>
                        <Flyout x:Name="FlyoutNewFile">
                            <StackPanel Spacing="8" Width="220">
                                <TextBlock Text="New File Name" FontWeight="SemiBold" FontSize="12" />
                                <TextBox x:Name="TxtNewFileName" PlaceholderText="e.g. auth_service.dart" KeyDown="TxtNewFileName_KeyDown" />
                                <Button Content="Create" HorizontalAlignment="Stretch" Style="{ThemeResource AccentButtonStyle}" Click="BtnCreateFileConfirm_Click" />
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>

                <!-- New Folder Button with Flyout -->
                <Button x:Name="BtnNewFolder" Background="Transparent" BorderThickness="0" Padding="6,4" CornerRadius="4" ToolTipService.ToolTip="New Folder">
                    <FontIcon Glyph="&#xE8F4;" FontSize="12" />
                    <Button.Flyout>
                        <Flyout x:Name="FlyoutNewFolder">
                            <StackPanel Spacing="8" Width="220">
                                <TextBlock Text="New Folder Name" FontWeight="SemiBold" FontSize="12" />
                                <TextBox x:Name="TxtNewFolderName" PlaceholderText="e.g. services" KeyDown="TxtNewFolderName_KeyDown" />
                                <Button Content="Create" HorizontalAlignment="Stretch" Style="{ThemeResource AccentButtonStyle}" Click="BtnCreateFolderConfirm_Click" />
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>

                <!-- Refresh Button -->
                <Button x:Name="BtnRefresh" Click="BtnRefresh_Click" Background="Transparent" BorderThickness="0" Padding="6,4" CornerRadius="4" ToolTipService.ToolTip="Refresh Explorer">
                    <FontIcon Glyph="&#xE72C;" FontSize="12" />
                </Button>

                <!-- Collapse All Button -->
                <Button x:Name="BtnCollapseAll" Click="BtnCollapseAll_Click" Background="Transparent" BorderThickness="0" Padding="6,4" CornerRadius="4" ToolTipService.ToolTip="Collapse All">
                    <FontIcon Glyph="&#xE7B7;" FontSize="12" />
                </Button>

                <!-- Reveal in Explorer Button -->
                <Button x:Name="BtnReveal" Click="BtnReveal_Click" Background="Transparent" BorderThickness="0" Padding="6,4" CornerRadius="4" ToolTipService.ToolTip="Reveal in Windows Explorer">
                    <FontIcon Glyph="&#xE8DA;" FontSize="12" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- Project TreeView -->
        <TreeView
            x:Name="ProjectTreeView"
            Grid.Row="1"
            ItemsSource="{x:Bind ViewModel.RootItems, Mode=OneWay}"
            ItemInvoked="ProjectTreeView_ItemInvoked"
            SelectionMode="Single"
            Padding="0,4"
            CanDragItems="False"
            CanReorderItems="False">

            <TreeView.ItemTemplate>
                <DataTemplate x:DataType="vm:FileItemViewModel">
                    <TreeViewItem
                        ItemsSource="{x:Bind Children, Mode=OneWay}"
                        IsExpanded="{x:Bind IsExpanded, Mode=TwoWay}"
                        RightTapped="TreeViewItem_RightTapped"
                        ContextFlyout="{StaticResource ItemContextFlyout}">
                        
                        <Grid Margin="0,2" ColumnSpacing="6" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- File/Folder Icon -->
                            <FontIcon
                                Grid.Column="0"
                                Glyph="{x:Bind IconGlyph, Mode=OneWay}"
                                FontSize="14"
                                VerticalAlignment="Center" />

                            <!-- File/Folder Name -->
                            <TextBlock
                                Grid.Column="1"
                                Text="{x:Bind Name, Mode=OneWay}"
                                FontSize="12.5"
                                TextTrimming="CharacterEllipsis"
                                VerticalAlignment="Center" />

                            <!-- Unsaved Dot -->
                            <FontIcon
                                Grid.Column="2"
                                Glyph="&#xEA3B;"
                                FontSize="8"
                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                Visibility="{x:Bind DirtyVisibility, Mode=OneWay}"
                                Margin="4,0,0,0"
                                VerticalAlignment="Center" />
                        </Grid>
                    </TreeViewItem>
                </DataTemplate>
            </TreeView.ItemTemplate>
        </TreeView>

        <!-- Inline Loading Indicator -->
        <ProgressRing
            Grid.Row="1"
            IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Width="28"
            Height="28" />
    </Grid>
</UserControl>
