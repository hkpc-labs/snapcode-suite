<Window
    x:Class="Snapcode.Views.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Snapcode.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="Transparent">
        <NavigationView x:Name="SettingsNav" 
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        PaneDisplayMode="Left"
                        SelectionChanged="SettingsNav_SelectionChanged"
                        Loaded="SettingsNav_Loaded">
            <NavigationView.Resources>
                <LinearGradientBrush x:Key="NavigationViewDefaultPaneBackground" StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#0087CEFA" Offset="0.0" />
                    <GradientStop Color="#3087CEFA" Offset="1.0" />
                </LinearGradientBrush>
                <LinearGradientBrush x:Key="NavigationViewExpandedPaneBackground" StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#0087CEFA" Offset="0.0" />
                    <GradientStop Color="#3087CEFA" Offset="1.0" />
                </LinearGradientBrush>
            </NavigationView.Resources>
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Toolchains" Tag="Toolchains">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE718;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Environment Variables" Tag="EnvVars">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE90F;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Android Devices" Tag="AndroidDevices">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8EA;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Appearance" Tag="Appearance">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE771;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Keyboard Shortcuts" Tag="Shortcuts">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE765;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Updates" Tag="Updates">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE895;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="About" Tag="About">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE946;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Grid>
                <!-- Toolchains -->
                <Grid x:Name="ToolchainsContent" Visibility="Collapsed" Padding="32">
                    <StackPanel Spacing="16">
                        <TextBlock Text="Toolchain Configuration" Style="{StaticResource TitleTextBlockStyle}" Margin="0,0,0,16" />
                        <TextBlock Text="Set custom paths for required SDKs if they are not in your system PATH." Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" />
                        
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TextBoxFlutterSdk" Header="Flutter SDK Path" PlaceholderText="e.g. C:\src\flutter" />
                            <Button Content="Browse..." Grid.Column="1" VerticalAlignment="Bottom" Margin="8,0,0,0" Click="BtnBrowseFlutter_Click" />
                        </Grid>
                        
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TextBoxGitPath" Header="Git Executable Path" PlaceholderText="e.g. C:\Program Files\Git\bin\git.exe" />
                            <Button Content="Browse..." Grid.Column="1" VerticalAlignment="Bottom" Margin="8,0,0,0" Click="BtnBrowseGit_Click" />
                        </Grid>
                        
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TextBoxAndroidSdk" Header="Android SDK Path" PlaceholderText="e.g. C:\Users\Username\AppData\Local\Android\Sdk" />
                            <Button Content="Browse..." Grid.Column="1" VerticalAlignment="Bottom" Margin="8,0,0,0" Click="BtnBrowseAndroid_Click" />
                        </Grid>
                        
                        <Button x:Name="BtnSavePaths" Content="Save Paths" Click="BtnSavePaths_Click" Style="{StaticResource AccentButtonStyle}" Margin="0,16,0,0" />
                    </StackPanel>
                </Grid>

                <!-- Environment Variables -->
                <Grid x:Name="EnvVarsContent" Visibility="Collapsed" Padding="32">
                    <StackPanel Spacing="16">
                        <TextBlock Text="Environment Variables Setup" Style="{StaticResource TitleTextBlockStyle}" Margin="0,0,0,16" />
                        <TextBlock Text="Snapcode can automatically configure your system environment variables for Flutter development." Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" TextWrapping="Wrap" />
                        
                        <Button x:Name="BtnScanEnv" Content="Scan Current Environment" Click="BtnScanEnv_Click" Margin="0,8,0,0" />
                        
                        <Border Background="{ThemeResource SystemControlBackgroundChromeMediumLowBrush}" Padding="16" CornerRadius="4" Margin="0,16,0,0">
                            <StackPanel Spacing="12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="System PATH status (Flutter)" VerticalAlignment="Center"/>
                                    <StackPanel x:Name="PathStatusPanel" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                        <FontIcon x:Name="PathStatusIcon" Glyph="&#xEA39;" Foreground="Red" />
                                        <TextBlock x:Name="PathStatusText" Text="Missing" Foreground="Red" />
                                    </StackPanel>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="JAVA_HOME status" VerticalAlignment="Center"/>
                                    <StackPanel x:Name="JavaStatusPanel" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                        <FontIcon x:Name="JavaStatusIcon" Glyph="&#xEA39;" Foreground="Red" />
                                        <TextBlock x:Name="JavaStatusText" Text="Not Set" Foreground="Red" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                        
                        <Button x:Name="BtnAutoFixEnv" Content="Auto-Fix Variables" Click="BtnAutoFixEnv_Click" Style="{StaticResource AccentButtonStyle}" IsEnabled="False" />
                    </StackPanel>
                </Grid>

                <!-- Android Devices -->
                <Grid x:Name="AndroidDevicesContent" Visibility="Collapsed" Padding="32">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    
                    <StackPanel Grid.Row="0" Spacing="16">
                        <TextBlock Text="Android Devices &amp; Emulators" Style="{StaticResource TitleTextBlockStyle}" Margin="0,0,0,16" />
                        <TextBlock Text="Detect running devices connected via USB debugging or launch an installed emulator." Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" TextWrapping="Wrap" />
                        <Button x:Name="BtnRefreshDevices" Content="Refresh Devices" Click="BtnRefreshDevices_Click" Margin="0,8,0,16" />
                    </StackPanel>

                    <Grid Grid.Row="1">
                        <StackPanel x:Name="AndroidLoadingPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16" Visibility="Collapsed">
                            <ProgressRing IsActive="True" Width="48" Height="48" />
                            <TextBlock Text="Checking Android SDK and detecting devices..." Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" />
                        </StackPanel>

                        <StackPanel x:Name="AndroidErrorPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16" Visibility="Collapsed">
                            <FontIcon Glyph="&#xEA39;" FontSize="48" Foreground="Red" />
                            <TextBlock Text="Android SDK or tools not found." FontSize="18" FontWeight="SemiBold" Foreground="Red" HorizontalAlignment="Center" />
                            <TextBlock x:Name="AndroidErrorText" Text="Please configure the Android SDK path in the Toolchains tab." Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" />
                            <Button Content="Go to Toolchains" Click="BtnFixAndroidSdk_Click" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Center" />
                        </StackPanel>

                        <ScrollViewer x:Name="AndroidDataPanel" VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="24">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Running Devices" FontWeight="SemiBold" FontSize="16" />
                                <TextBlock x:Name="TxtNoRunningDevices" Text="No running devices detected." FontStyle="Italic" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" />
                                <ListView x:Name="ListRunningDevices" SelectionMode="None">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{ThemeResource SystemControlBackgroundChromeMediumLowBrush}" Padding="16" Margin="0,0,0,8" CornerRadius="4">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <FontIcon Glyph="&#xE8EA;" FontSize="24" Margin="0,0,16,0" Foreground="{ThemeResource SystemControlForegroundAccentBrush}" />
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" />
                                                        <TextBlock Text="{Binding Id}" FontSize="12" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>

                            <StackPanel Spacing="8">
                                <TextBlock Text="Installed Emulators (AVDs)" FontWeight="SemiBold" FontSize="16" />
                                <TextBlock x:Name="TxtNoAvds" Text="No installed emulators found." FontStyle="Italic" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" />
                                <ListView x:Name="ListInstalledAvds" SelectionMode="None">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{ThemeResource SystemControlBackgroundChromeMediumLowBrush}" Padding="16" Margin="0,0,0,8" CornerRadius="4">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <FontIcon Glyph="&#xE99A;" FontSize="24" Margin="0,0,16,0" />
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" />
                                                    </StackPanel>
                                                    <Button Grid.Column="2" Content="Launch" Tag="{Binding Id}" Click="BtnLaunchAvd_Click" Style="{StaticResource AccentButtonStyle}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                    </Grid>
                </Grid>

                <!-- Appearance -->
                <Grid x:Name="AppearanceContent" Visibility="Collapsed" Padding="32">
                    <StackPanel Spacing="16">
                        <TextBlock Text="Appearance &amp; Theme" Style="{StaticResource TitleTextBlockStyle}" Margin="0,0,0,16" />
                        <ComboBox x:Name="ComboAppTheme" Header="App Theme" SelectedIndex="0" Width="200" SelectionChanged="ComboAppTheme_SelectionChanged">
                            <x:String>System Default</x:String>
                            <x:String>Light</x:String>
                            <x:String>Dark</x:String>
                        </ComboBox>
                        
                        <ComboBox x:Name="ComboEditorFont" Header="Editor Font" SelectedIndex="0" Width="200" SelectionChanged="ComboEditorFont_SelectionChanged">
                            <x:String>Consolas</x:String>
                            <x:String>Cascadia Code</x:String>
                            <x:String>Fira Code</x:String>
                        </ComboBox>
                    </StackPanel>
                </Grid>

                <!-- Keyboard Shortcuts -->
                <Grid x:Name="ShortcutsContent" Visibility="Collapsed" Padding="32">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Spacing="6" Margin="0,0,0,16">
                        <TextBlock Text="Keyboard Shortcuts" Style="{StaticResource TitleTextBlockStyle}" />
                        <TextBlock Text="Configure shortcuts for quick tools, designer operations, and Flutter execution. Windows system shortcuts are automatically protected." Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" />
                    </StackPanel>

                    <!-- Filter and Action Buttons -->
                    <Grid Grid.Row="1" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="SearchShortcuts" PlaceholderText="Search commands or shortcuts..." TextChanged="SearchShortcuts_TextChanged" MaxWidth="320" HorizontalAlignment="Left" Width="300" />

                        <Button x:Name="BtnResetAllShortcuts" Content="Reset All to Defaults" Click="BtnResetAllShortcuts_Click" Grid.Column="1" Margin="12,0,0,0" />
                        <Button x:Name="BtnSaveShortcuts" Content="Save Shortcuts" Click="BtnSaveShortcuts_Click" Grid.Column="2" Style="{StaticResource AccentButtonStyle}" Margin="8,0,0,0" />
                    </Grid>

                    <!-- Shortcuts ListView -->
                    <ListView x:Name="ListShortcuts" Grid.Row="2" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{ThemeResource SystemControlBackgroundChromeMediumLowBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" />
                                                <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="6,1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Category}" FontSize="10" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" FontWeight="Medium" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" TextWrapping="Wrap" />
                                        </StackPanel>

                                        <!-- Shortcut Key Badge -->
                                        <Border Grid.Column="1" Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4" Padding="10,4" VerticalAlignment="Center" Margin="12,0">
                                            <TextBlock Text="{Binding DisplayText}" FontWeight="SemiBold" FontSize="12" FontFamily="Consolas" />
                                        </Border>

                                        <!-- Actions: Edit & Reset -->
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <Button Content="Edit" Tag="{Binding Id}" Click="BtnEditShortcut_Click" Padding="10,4" FontSize="12" />
                                            <Button Content="Reset" Tag="{Binding Id}" Click="BtnResetSingleShortcut_Click" Padding="8,4" FontSize="11" ToolTipService.ToolTip="Reset this command to default" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <!-- Status Notification Banner -->
                    <Border x:Name="ShortcutNoticeBanner" Grid.Row="3" Visibility="Collapsed" Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,12,0,0">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon x:Name="ShortcutNoticeIcon" Glyph="&#xE73E;" Foreground="{ThemeResource SystemControlBackgroundAccentBrush}" FontSize="14" VerticalAlignment="Center" />
                            <TextBlock x:Name="ShortcutNoticeText" Text="Shortcuts saved successfully." FontSize="12" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Updates -->
                <Grid x:Name="UpdatesContent" Visibility="Collapsed" Padding="32">
                    <StackPanel Spacing="16" HorizontalAlignment="Left">
                        <TextBlock Text="Version Update Check" Style="{StaticResource TitleTextBlockStyle}" Margin="0,0,0,16" />
                        <TextBlock Text="Current Version: v1.0.0-beta" />
                        <Button Content="Check for Updates" Style="{StaticResource AccentButtonStyle}" />
                    </StackPanel>
                </Grid>

                <!-- About -->
                <Grid x:Name="AboutContent" Visibility="Collapsed" Padding="32">
                    <StackPanel Spacing="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE8A5;" FontSize="72" Foreground="{ThemeResource SystemControlBackgroundAccentBrush}" Margin="0,0,0,16" />
                        <TextBlock Text="Snapcode" FontSize="32" FontWeight="Bold" HorizontalAlignment="Center" />
                        <TextBlock Text="Version 1.0.0-beta" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="Created by hkpc labs" FontWeight="SemiBold" FontSize="16" Margin="0,16,0,0" HorizontalAlignment="Center" />
                        <TextBlock Text="Empowering developers to build beautiful apps effortlessly." FontStyle="Italic" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" HorizontalAlignment="Center" />
                        <Button Content="Reset App Data" Click="BtnResetData_Click" Margin="0,32,0,0" HorizontalAlignment="Center" Foreground="{ThemeResource SystemControlErrorTextForegroundBrush}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </NavigationView>
    </Grid>
</Window>
