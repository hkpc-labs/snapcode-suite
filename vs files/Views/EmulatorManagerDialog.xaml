<ContentDialog
    x:Class="Snapcode.Views.EmulatorManagerDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Snapcode.Models"
    mc:Ignorable="d"
    Title="Android Emulator Manager"
    PrimaryButtonText="Close"
    DefaultButton="Primary">

    <Grid Width="460" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Description -->
        <TextBlock Grid.Row="0" Text="Select an Android Virtual Device (AVD) to launch or monitor:" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="13" TextWrapping="Wrap" />

        <!-- Loading indicator -->
        <ProgressBar x:Name="ProgressScan" Grid.Row="0" IsIndeterminate="True" Visibility="Collapsed" VerticalAlignment="Bottom" Margin="0,0,0,-8" />

        <!-- Emulator List -->
        <ListView x:Name="ListEmulators" Grid.Row="1" MinHeight="160" MaxHeight="240" SelectionMode="Single" ShowsScrollingPlaceholders="False" Margin="0,8,0,0">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:FlutterDevice">
                    <Grid Padding="8,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Phone Icon -->
                        <FontIcon Grid.Column="0" Glyph="&#xE8EA;" FontSize="20" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Margin="0,0,12,0" VerticalAlignment="Center" />

                        <!-- Name and Status -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" FontSize="13" />
                            <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2,0,0">
                                <TextBlock Text="{x:Bind Id}" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" FontFamily="Consolas" />
                                <TextBlock Text="•" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                <TextBlock Text="{x:Bind DisplayName}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Launch Button -->
                        <Button Grid.Column="2" Content="Launch" Click="BtnLaunchItem_Click" Tag="{x:Bind Id}" Height="30" Padding="12,0" VerticalAlignment="Center" CornerRadius="4" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Status message / Empty state -->
        <TextBlock x:Name="TxtEmptyNotice" Grid.Row="1" Text="No Android Virtual Devices (AVDs) found. Make sure Android SDK and an AVD are created in Android Studio." Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" TextWrapping="Wrap" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" Margin="16" />

        <!-- Action Bar -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button x:Name="BtnRefresh" Click="BtnRefresh_Click" Height="32">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE72C;" FontSize="12" />
                    <TextBlock Text="Refresh" FontSize="12" />
                </StackPanel>
            </Button>
        </StackPanel>

        <!-- Status feedback -->
        <TextBlock x:Name="TxtStatusFeedback" Grid.Row="3" Text="" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" FontSize="12" TextWrapping="Wrap" />
    </Grid>
</ContentDialog>
