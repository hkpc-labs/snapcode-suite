<ContentDialog
    x:Class="Snapcode.Views.NewProjectDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Snapcode.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="New Flutter Project"
    PrimaryButtonText="Create"
    SecondaryButtonText="Cancel"
    DefaultButton="Primary"
    PrimaryButtonClick="ContentDialog_PrimaryButtonClick"
    Opened="ContentDialog_Opened"
    Style="{StaticResource DefaultContentDialogStyle}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="16" MinWidth="450">
            <!-- Project Name -->
            <TextBox x:Name="ProjectNameTextBox" 
                     Header="Project Name" 
                     PlaceholderText="e.g. snapcode_app"
                     TextChanged="ProjectNameTextBox_TextChanged"/>
            <TextBlock x:Name="NameErrorTextBlock" 
                       Foreground="{ThemeResource SystemControlErrorTextForegroundBrush}"
                       FontSize="12"
                       Visibility="Collapsed" />

            <!-- Organization -->
            <TextBox x:Name="OrgTextBox" 
                     Header="Organization" 
                     PlaceholderText="e.g. com.example"
                     Text="com.example"/>

            <!-- Location -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="LocationTextBox" 
                         Header="Project Location" 
                         IsReadOnly="True"/>
                <Button Grid.Column="1" 
                        VerticalAlignment="Bottom"
                        Margin="8,0,0,0"
                        Content="Browse..." 
                        Click="BtnBrowse_Click"/>
            </Grid>

            <!-- Target Platforms -->
            <TextBlock Text="Target Platforms" Margin="0,8,0,0" FontWeight="SemiBold" />
            
            <VariableSizedWrapGrid Orientation="Horizontal" ItemWidth="100" ItemHeight="40">
                <CheckBox x:Name="ChkWeb" Content="Web" IsChecked="True" />
                <CheckBox x:Name="ChkAndroid" Content="Android" IsChecked="True" />
                <CheckBox x:Name="ChkIos" Content="iOS" IsChecked="True" />
                <CheckBox x:Name="ChkWindows" Content="Windows" IsChecked="True" />
                <CheckBox x:Name="ChkMacOs" Content="macOS" IsChecked="True" />
                <CheckBox x:Name="ChkLinux" Content="Linux" IsChecked="True" />
            </VariableSizedWrapGrid>

            <!-- Progress section -->
            <StackPanel x:Name="ProgressPanel" Visibility="Collapsed" Spacing="8">
                <TextBlock x:Name="StatusTextBlock" Text="Creating project..." FontWeight="SemiBold" />
                <ProgressBar x:Name="CreationProgressBar" IsIndeterminate="True" />
                <ScrollViewer MaxHeight="100" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
                    <TextBlock x:Name="LogTextBlock" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" />
                </ScrollViewer>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
