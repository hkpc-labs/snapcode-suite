<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Snapcode.Views.SetupWizardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Snapcode.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent"
    Loaded="Page_Loaded">

    <Page.Resources>
        <!-- Accent color brush for progress and highlights -->
        <SolidColorBrush x:Key="SnapAccentBrush" Color="#6C5CE7" />
        <SolidColorBrush x:Key="SnapAccentLightBrush" Color="#A29BFE" />
        <SolidColorBrush x:Key="SnapSuccessBrush" Color="#00B894" />
        <SolidColorBrush x:Key="SnapWarningBrush" Color="#FDCB6E" />
        <SolidColorBrush x:Key="SnapErrorBrush" Color="#E17055" />
        <SolidColorBrush x:Key="SnapTextDimBrush" Color="#B2BEC3" />
    </Page.Resources>

    <Grid Padding="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- TOP RIGHT CONTROLS (Help & Rescan) -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" 
                    Margin="0,48,24,0" Spacing="8" Canvas.ZIndex="100">
            <Button x:Name="TopRescanButton" Style="{StaticResource TransparentButtonStyle}" 
                    ToolTipService.ToolTip="Scan Again" Click="RescanButton_Click">
                <FontIcon Glyph="&#xE895;" FontSize="16" />
            </Button>
            <Button x:Name="TopHelpButton" Style="{StaticResource TransparentButtonStyle}" 
                    ToolTipService.ToolTip="Help" Click="HelpButton_Click">
                <FontIcon Glyph="&#xE897;" FontSize="16" />
            </Button>
        </StackPanel>

        <!-- ═══════════════════════════════════════════════════════════ -->
        <!--  TOP: Step Indicator Bar                                    -->
        <!-- ═══════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="0" Padding="48,32,48,24" x:Name="StepIndicatorsPanel">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Step 1 -->
            <StackPanel Grid.Column="0" HorizontalAlignment="Center" Spacing="6">
                <Border x:Name="Step1Circle" Width="36" Height="36" CornerRadius="18"
                        Background="{StaticResource SnapAccentBrush}" HorizontalAlignment="Center">
                    <TextBlock x:Name="Step1Text" Text="1" Foreground="White" FontWeight="SemiBold"
                               HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14" />
                </Border>
                <TextBlock x:Name="Step1Label" Text="Welcome" FontSize="12" Foreground="{StaticResource SnapAccentLightBrush}"
                           HorizontalAlignment="Center" FontWeight="SemiBold" />
            </StackPanel>

            <!-- Step 2 -->
            <StackPanel Grid.Column="1" HorizontalAlignment="Center" Spacing="6">
                <Border x:Name="Step2Circle" Width="36" Height="36" CornerRadius="18"
                        Background="#3D3D3D" HorizontalAlignment="Center">
                    <TextBlock x:Name="Step2Text" Text="2" Foreground="#888888" FontWeight="SemiBold"
                               HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14" />
                </Border>
                <TextBlock x:Name="Step2Label" Text="System Scan" FontSize="12" Foreground="{StaticResource SnapTextDimBrush}"
                           HorizontalAlignment="Center" />
            </StackPanel>

            <!-- Step 3 -->
            <StackPanel Grid.Column="2" HorizontalAlignment="Center" Spacing="6">
                <Border x:Name="Step3Circle" Width="36" Height="36" CornerRadius="18"
                        Background="#3D3D3D" HorizontalAlignment="Center">
                    <TextBlock x:Name="Step3Text" Text="3" Foreground="#888888" FontWeight="SemiBold"
                               HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14" />
                </Border>
                <TextBlock x:Name="Step3Label" Text="Configure" FontSize="12" Foreground="{StaticResource SnapTextDimBrush}"
                           HorizontalAlignment="Center" />
            </StackPanel>

            <!-- Step 4 -->
            <StackPanel Grid.Column="3" HorizontalAlignment="Center" Spacing="6">
                <Border x:Name="Step4Circle" Width="36" Height="36" CornerRadius="18"
                        Background="#3D3D3D" HorizontalAlignment="Center">
                    <TextBlock x:Name="Step4Text" Text="4" Foreground="#888888" FontWeight="SemiBold"
                               HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14" />
                </Border>
                <TextBlock x:Name="Step4Label" Text="Ready!" FontSize="12" Foreground="{StaticResource SnapTextDimBrush}"
                           HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- ═══════════════════════════════════════════════════════════ -->
        <!--  CENTER: Page Content (switches per step)                   -->
        <!-- ═══════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="1" Padding="48,0,48,0">

            <!-- FULL PAGE LOADING OVERLAY (Shown during scans) -->
            <StackPanel x:Name="LoadingOverlay" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="16">
                <ProgressRing IsActive="True" Width="64" Height="64" Foreground="{StaticResource SnapAccentBrush}" />
                <TextBlock Text="Scanning system... Please wait." FontSize="18" Foreground="{StaticResource SnapTextDimBrush}" />
            </StackPanel>

            <!-- STEP 1: Welcome -->
            <StackPanel x:Name="WelcomePanel" Visibility="Visible"
                        VerticalAlignment="Center" HorizontalAlignment="Center"
                        Spacing="16" MaxWidth="600">
                <FontIcon Glyph="&#xE943;" FontSize="64"
                          Foreground="{StaticResource SnapAccentBrush}"
                          HorizontalAlignment="Center" />
                <TextBlock Text="Welcome to SnapCode"
                           FontSize="32" FontWeight="Bold" HorizontalAlignment="Center"
                           Foreground="White" />
                <TextBlock Text="Visual Block Coding → Flutter Apps"
                           FontSize="16" HorizontalAlignment="Center"
                           Foreground="{StaticResource SnapAccentLightBrush}" FontWeight="SemiBold" />
                <TextBlock TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center"
                           Foreground="{StaticResource SnapTextDimBrush}" FontSize="14" LineHeight="22"
                           Margin="0,8,0,0">
                    SnapCode lets you build cross-platform apps by dragging and dropping visual logic blocks.
                    Your blocks are compiled into real Flutter/Dart code that runs on Windows, Android, and Web.
                    <LineBreak /><LineBreak />
                    Before we begin, let's make sure your system has all the required tools installed.
                </TextBlock>
            </StackPanel>

            <!-- STEP 2: System Diagnostics -->
            <Grid x:Name="DiagnosticsPanel" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="System Diagnostics" FontSize="24" FontWeight="Bold" Foreground="White" Margin="0,0,0,4" />
                <TextBlock Grid.Row="1" Foreground="{StaticResource SnapTextDimBrush}" FontSize="13" Margin="0,0,0,16">
                    Results of the system scan.
                </TextBlock>

                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="DiagnosticsList" Spacing="8" />
                </ScrollViewer>
            </Grid>

            <!-- STEP 3: Configuration / Fix Issues -->
            <Grid x:Name="ConfigurePanel" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Configure &amp; Fix" FontSize="24" FontWeight="Bold" Foreground="White" Margin="0,0,0,4" />
                <TextBlock Grid.Row="1" x:Name="ConfigSubtitle" Foreground="{StaticResource SnapTextDimBrush}" FontSize="13" Margin="0,0,0,16">
                    Review the issues below and apply fixes. You can also manually set custom paths.
                </TextBlock>

                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="FixList" Spacing="12" />
                </ScrollViewer>
            </Grid>

            <!-- STEP 4: Ready -->
            <StackPanel x:Name="ReadyPanel" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="16" MaxWidth="600">
                <FontIcon x:Name="ReadyIcon" Glyph="&#xE73E;" FontSize="64" Foreground="{StaticResource SnapSuccessBrush}" HorizontalAlignment="Center" />
                <TextBlock x:Name="ReadyTitle" Text="You're All Set!" FontSize="32" FontWeight="Bold" HorizontalAlignment="Center" Foreground="White" />
                <TextBlock x:Name="ReadySubtitle" TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center"
                           Foreground="{StaticResource SnapTextDimBrush}" FontSize="14" LineHeight="22">
                    Your development environment is configured and ready.
                    Click 'Launch SnapCode' to start building apps!
                </TextBlock>
                <StackPanel x:Name="ReadySummary" Spacing="8" Margin="0,16,0,0" />
            </StackPanel>
        </Grid>

        <!-- ═══════════════════════════════════════════════════════════ -->
        <!--  BOTTOM: Navigation Buttons                                 -->
        <!-- ═══════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="2" Padding="48,16,48,32" x:Name="BottomNavPanel">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Back + Next/Finish -->
            <Button x:Name="BackButton" Grid.Column="1" Content="Back"
                    Click="BackButton_Click" Visibility="Collapsed"
                    Style="{StaticResource DefaultButtonStyle}" Margin="0,0,12,0" Padding="20,8" />
            <Button x:Name="NextButton" Grid.Column="2" Content="Get Started"
                    Click="NextButton_Click"
                    Style="{StaticResource AccentButtonStyle}" Padding="24,8" />
        </Grid>
    </Grid>
</Page>
