<Window
    x:Class="Snapcode.Views.NewProjectWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Snapcode.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Background="{ThemeResource SystemControlBackgroundChromeMediumBrush}" Padding="24,16">
            <TextBlock x:Name="HeaderTitleTextBlock" Text="Step 1: Project Details" Style="{StaticResource SubtitleTextBlockStyle}" FontWeight="SemiBold"/>
        </Grid>

        <!-- Main Content Area -->
        <Grid Grid.Row="1" Padding="32,24">
            
            <!-- Step 1: Project Details -->
            <StackPanel x:Name="Step1Panel" Visibility="Visible" Spacing="20">
                <TextBlock Text="Configure your new Flutter project." Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" Margin="0,0,0,8" />
                
                <TextBox x:Name="ProjectNameTextBox" Header="Project Name" PlaceholderText="e.g. snapcode_app" TextChanged="ProjectNameTextBox_TextChanged" />
                <TextBlock x:Name="NameErrorTextBlock" Foreground="{ThemeResource SystemControlErrorTextForegroundBrush}" FontSize="12" Visibility="Collapsed" />
                
                <TextBox x:Name="OrgTextBox" Header="Organization / Company" PlaceholderText="e.g. com.example" Text="com.example" />
                
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="LocationTextBox" Header="Location" IsReadOnly="True" />
                    <Button Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Bottom" Content="Browse..." Click="BtnBrowse_Click" />
                </Grid>
            </StackPanel>

            <!-- Step 2: Target Platforms -->
            <StackPanel x:Name="Step2Panel" Visibility="Collapsed" Spacing="20">
                <TextBlock Text="Select the platforms your app will support." Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" Margin="0,0,0,8" />
                
                <VariableSizedWrapGrid Orientation="Horizontal" ItemWidth="120" ItemHeight="48">
                    <ToggleButton x:Name="ToggleWeb" Content="Web" IsChecked="True" Checked="TogglePlatform_Changed" Unchecked="TogglePlatform_Changed" Margin="0,0,8,8" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                    <ToggleButton x:Name="ToggleAndroid" Content="Android" IsChecked="True" Checked="TogglePlatform_Changed" Unchecked="TogglePlatform_Changed" Margin="0,0,8,8" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                    <ToggleButton x:Name="ToggleIos" Content="iOS" IsChecked="False" Checked="TogglePlatform_Changed" Unchecked="TogglePlatform_Changed" Margin="0,0,8,8" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                    <ToggleButton x:Name="ToggleWindows" Content="Windows" IsChecked="True" Checked="TogglePlatform_Changed" Unchecked="TogglePlatform_Changed" Margin="0,0,8,8" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                    <ToggleButton x:Name="ToggleMacOs" Content="macOS" IsChecked="False" Checked="TogglePlatform_Changed" Unchecked="TogglePlatform_Changed" Margin="0,0,8,8" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                    <ToggleButton x:Name="ToggleLinux" Content="Linux" IsChecked="False" Checked="TogglePlatform_Changed" Unchecked="TogglePlatform_Changed" Margin="0,0,8,8" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                </VariableSizedWrapGrid>

                <StackPanel x:Name="AndroidOptionsPanel" Spacing="12" Margin="0,16,0,0" Padding="16" Background="{ThemeResource SystemControlBackgroundChromeMediumLowBrush}" CornerRadius="4">
                    <TextBlock Text="Android Specific Settings" FontWeight="SemiBold" />
                    <CheckBox x:Name="ChkAutoLaunchEmulator" Content="Auto-launch emulator when running" IsChecked="True" />
                    <CheckBox x:Name="ChkKotlin" Content="Use Kotlin (instead of Java)" IsChecked="True" />
                </StackPanel>
            </StackPanel>

            <!-- Step 3: Toolchains -->
            <StackPanel x:Name="Step3Panel" Visibility="Collapsed" Spacing="20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Verifying required environment for selected platforms." Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Click="BtnRescan_Click" Style="{StaticResource AccentButtonStyle}">
                        <Button.Content>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE72C;" FontSize="14" />
                                <TextBlock Text="Rescan Environment" />
                            </StackPanel>
                        </Button.Content>
                    </Button>
                </Grid>
                
                <GridView x:Name="DiagnosticsList" SelectionMode="None" HorizontalAlignment="Center">
                    <GridView.ItemTemplate>
                        <DataTemplate>
                            <Border Width="340" Height="140" Padding="16" Margin="8" Background="{ThemeResource SystemControlBackgroundChromeMediumLowBrush}" CornerRadius="6" BorderThickness="1" BorderBrush="{ThemeResource SystemControlForegroundBaseLowBrush}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    
                                    <FontIcon Glyph="{Binding IconGlyph}" FontSize="20" VerticalAlignment="Center" Margin="0,0,12,0" />
                                    <TextBlock Grid.Column="1" Text="{Binding DisplayName}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    
                                    <FontIcon Grid.Column="2" Glyph="{Binding StatusGlyph}" Foreground="{Binding StatusBrush}" VerticalAlignment="Center" />
                                    <ProgressRing Grid.Column="2" IsActive="{Binding IsValidating}" Width="16" Height="16" />
                                    
                                    <TextBlock Grid.Row="1" Grid.ColumnSpan="3" Text="{Binding StatusMessage}" FontSize="12" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" TextWrapping="Wrap" Margin="0,8,0,0" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>
                <TextBlock x:Name="EnvErrorTextBlock" Foreground="{ThemeResource SystemControlErrorTextForegroundBrush}" Visibility="Collapsed" />
            </StackPanel>

        </Grid>

        <!-- Footer / Navigation -->
        <Grid Grid.Row="2" Background="{ThemeResource SystemControlBackgroundChromeMediumBrush}" Padding="24,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button x:Name="BtnCancel" Content="Cancel" Click="BtnCancel_Click" Width="100"/>

            <Button x:Name="BtnBack" Grid.Column="2" Content="Back" Click="BtnBack_Click" Margin="0,0,12,0" Width="100" IsEnabled="False" />
            <Button x:Name="BtnNext" Grid.Column="3" Content="Next" Click="BtnNext_Click" Style="{StaticResource AccentButtonStyle}" Width="100" />
        </Grid>

    </Grid>
</Window>
