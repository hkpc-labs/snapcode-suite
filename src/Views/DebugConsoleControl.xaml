<UserControl
    x:Class="Snapcode.Views.DebugConsoleControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Snapcode.Models"
    mc:Ignorable="d">

    <UserControl.Resources>
        <SolidColorBrush x:Key="BadgeErrorBgBrush" Color="#33F44336" />
        <SolidColorBrush x:Key="BadgeWarningBgBrush" Color="#33FFA000" />
    </UserControl.Resources>

    <Grid Background="{ThemeResource LayerFillColorDefaultBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="38" />
            <RowDefinition Height="*" />
            <RowDefinition Height="36" />
        </Grid.RowDefinitions>

        <!-- TOP TOOLBAR -->
        <Grid Grid.Row="0" Background="{ThemeResource SubtleFillColorSecondaryBrush}" Padding="10,0" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Left: Title, Status Indicator & Badges -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE756;" FontSize="13" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                <TextBlock Text="Debug Console" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />

                <!-- Status Pill -->
                <Border x:Name="PillStatus" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="10" Padding="8,2" Margin="4,0,0,0">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <Ellipse x:Name="DotStatus" Width="6" Height="6" Fill="#9E9E9E" />
                        <TextBlock x:Name="TxtStatus" Text="Idle" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Border>

                <!-- Error Badge -->
                <Border x:Name="BadgeErrors" Background="{StaticResource BadgeErrorBgBrush}" CornerRadius="10" Padding="6,2">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <FontIcon Glyph="&#xEA39;" FontSize="10" Foreground="#F44336" />
                        <TextBlock x:Name="TxtErrorCount" Text="0 Errors" FontSize="11" Foreground="#F44336" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>

                <!-- Warning Badge -->
                <Border x:Name="BadgeWarnings" Background="{StaticResource BadgeWarningBgBrush}" CornerRadius="10" Padding="6,2">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <FontIcon Glyph="&#xE7BA;" FontSize="10" Foreground="#FFA000" />
                        <TextBlock x:Name="TxtWarningCount" Text="0 Warnings" FontSize="11" Foreground="#FFA000" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Center: Filter Dropdown & Search -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                <ComboBox x:Name="ComboFilter" SelectedIndex="0" Height="26" Width="130" FontSize="11" Padding="6,0" SelectionChanged="ComboFilter_SelectionChanged">
                    <ComboBoxItem Content="All Output" Tag="all" />
                    <ComboBoxItem Content="Errors Only" Tag="errors" />
                    <ComboBoxItem Content="Warnings &amp; Errors" Tag="warnings" />
                    <ComboBoxItem Content="Reloads &amp; Builds" Tag="reloads" />
                </ComboBox>

                <TextBox x:Name="TxtSearch" PlaceholderText="Filter logs..." Width="160" Height="26" FontSize="11" TextChanged="TxtSearch_TextChanged" />
            </StackPanel>

            <!-- Right: Action Buttons -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                <!-- Hot Reload -->
                <Button x:Name="BtnHotReload" Click="BtnHotReload_Click" IsEnabled="False" Height="28" Padding="8,2" CornerRadius="4" ToolTipService.ToolTip="Hot Reload (Ctrl+F10)">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <FontIcon Glyph="&#xE72C;" FontSize="12" Foreground="#00BCD4" />
                        <TextBlock Text="Reload" FontSize="11" />
                    </StackPanel>
                </Button>

                <!-- Hot Restart -->
                <Button x:Name="BtnHotRestart" Click="BtnHotRestart_Click" IsEnabled="False" Height="28" Padding="8,2" CornerRadius="4" ToolTipService.ToolTip="Hot Restart (Ctrl+Shift+F10)">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <FontIcon Glyph="&#xE777;" FontSize="12" Foreground="#FF9800" />
                        <TextBlock Text="Restart" FontSize="11" />
                    </StackPanel>
                </Button>

                <!-- Stop -->
                <Button x:Name="BtnStop" Click="BtnStop_Click" IsEnabled="False" Height="28" Padding="8,2" CornerRadius="4" ToolTipService.ToolTip="Stop Application">
                    <FontIcon Glyph="&#xE71A;" FontSize="12" Foreground="#F44336" />
                </Button>

                <Border Width="1" Height="16" Background="{ThemeResource CardStrokeColorDefaultBrush}" Margin="4,0" />

                <!-- DevTools Web Link -->
                <Button x:Name="BtnDevTools" Click="BtnDevTools_Click" Visibility="Collapsed" Height="28" Padding="8,2" CornerRadius="4" ToolTipService.ToolTip="Open Flutter DevTools in Browser">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <FontIcon Glyph="&#xE774;" FontSize="12" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        <TextBlock Text="DevTools" FontSize="11" />
                    </StackPanel>
                </Button>

                <!-- Auto-Scroll Toggle -->
                <ToggleButton x:Name="ToggleAutoScroll" IsChecked="True" Height="28" Width="28" Padding="0" CornerRadius="4" ToolTipService.ToolTip="Auto-scroll to bottom">
                    <FontIcon Glyph="&#xE74B;" FontSize="11" />
                </ToggleButton>

                <!-- Clear Logs -->
                <Button x:Name="BtnClear" Click="BtnClear_Click" Height="28" Width="28" Padding="0" CornerRadius="4" ToolTipService.ToolTip="Clear Console">
                    <FontIcon Glyph="&#xE74D;" FontSize="11" />
                </Button>

                <!-- Copy All -->
                <Button x:Name="BtnCopy" Click="BtnCopy_Click" Height="28" Width="28" Padding="0" CornerRadius="4" ToolTipService.ToolTip="Copy All Logs">
                    <FontIcon Glyph="&#xE8C8;" FontSize="11" />
                </Button>

                <!-- Pop out standalone window -->
                <Button x:Name="BtnPopOut" Click="BtnPopOut_Click" Height="28" Width="28" Padding="0" CornerRadius="4" ToolTipService.ToolTip="Open in Dedicated Window">
                    <FontIcon Glyph="&#xE78B;" FontSize="11" />
                </Button>

                <!-- Close / Collapse drawer -->
                <Button x:Name="BtnClose" Click="BtnClose_Click" Height="28" Width="28" Padding="0" CornerRadius="4" ToolTipService.ToolTip="Close Console">
                    <FontIcon Glyph="&#xE711;" FontSize="11" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- LOG LIST VIEW -->
        <ListView x:Name="ListLogs" Grid.Row="1" SelectionMode="None" Padding="4" Background="{ThemeResource LayerFillColorDefaultBrush}">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:DebugLogEntry">
                    <Grid Padding="4,1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Icon -->
                        <FontIcon Grid.Column="0" Glyph="{x:Bind IconGlyph}" FontSize="11" Foreground="{x:Bind ColorBrush}" VerticalAlignment="Top" Margin="0,3,6,0" />

                        <!-- Timestamp -->
                        <TextBlock Grid.Column="1" Text="{x:Bind FormattedTime}" FontFamily="Consolas" FontSize="11" Foreground="#757575" Margin="0,0,8,0" VerticalAlignment="Top" />

                        <!-- Message -->
                        <TextBlock Grid.Column="2" Text="{x:Bind Message}" FontFamily="Consolas" FontSize="11" Foreground="{x:Bind ColorBrush}" TextWrapping="Wrap" VerticalAlignment="Top" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- BOTTOM INTERACTIVE INPUT BAR -->
        <Grid Grid.Row="2" Background="{ThemeResource SubtleFillColorSecondaryBrush}" Padding="8,4" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="flutter run >" FontFamily="Consolas" FontSize="11" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" Margin="4,0,8,0" FontWeight="SemiBold" />

            <TextBox x:Name="TxtCommand" Grid.Column="1" PlaceholderText="Type interactive command (r: reload, R: restart, q: quit, h: help, p: inspector)..." FontFamily="Consolas" FontSize="11" Height="26" Padding="6,2" KeyDown="TxtCommand_KeyDown" />

            <Button x:Name="BtnSendCommand" Grid.Column="2" Content="Send" Click="BtnSendCommand_Click" Height="26" Padding="12,0" Margin="6,0,0,0" FontSize="11" />
        </Grid>
    </Grid>
</UserControl>
